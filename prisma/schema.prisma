generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
  
}

model  User{
  id Int @id @default(autoincrement())
  name String
  email String @unique
  password String
  project Project[]

}

model Project{
  id Int @id @default(autoincrement())
  title String
  description String
  userId Int
  user User @relation(fields: [userId],references: [id], onDelete: Cascade)
}